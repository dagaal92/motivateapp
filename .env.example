# Pega aquí tu connection string de Neon
# La encuentras en el dashboard de Neon > tu proyecto > Connection Details
DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/nombre_db?sslmode=require"

# Shopify: Configuración > Apps y canales de venta > Desarrollar apps > tu app > API credentials
SHOPIFY_STORE_DOMAIN="tu-tienda.myshopify.com"
SHOPIFY_ADMIN_API_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# "API secret key" / "Client secret" de la misma app (se usa para verificar los webhooks)
SHOPIFY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Contraseña compartida para entrar a la app. Sin esta variable configurada
# en el entorno, la app niega el acceso a todo el mundo (no lo deja abierto).
ADMIN_PASSWORD="elige-una-contraseña-fuerte"

# Kapso: para avisarle al cliente por WhatsApp (plantilla "compartir_guia")
# cuando Shopify recibe el número de guía. Panel de Kapso > tu app de
# WhatsApp > API keys / Phone Number ID.
KAPSO_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KAPSO_PHONE_NUMBER_ID="123456789012345"
# Secreto que se define al registrar el webhook de mensajes en Kapso (para
# verificar que las llamadas a /api/kapso/webhook realmente vienen de Kapso).
KAPSO_WEBHOOK_SECRET="elige-un-secreto-largo-y-aleatorio"
